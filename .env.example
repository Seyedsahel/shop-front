# Backend origin reachable from the container. Do not append /tbt; Nuxt adds it.
NUXT_BACKEND_URL=https://api.example.com
# Catalog image base (including /images); uploads use the backend origin above.
NUXT_PUBLIC_IMAGE_BASE_URL=https://api.example.com/images
# Public storefront origin for canonical and Open Graph URLs.
NUXT_PUBLIC_SITE_URL=https://shop.example.com
# Use 3001 by default so shop-admin can keep port 3000.
FRONT_PORT=3001
